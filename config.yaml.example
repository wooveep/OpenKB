# Desktop model defaults. Save as <knowledge-base>/.openkb/config.yaml,
# or configure the same values from the Settings panel.
model: gpt-5.4

desktop:
  # Credentials stay in the named environment variable or KB-local .env file.
  credential_reference: env:LLM_API_KEY
  max_concurrent_model_calls: 1
  initial_timeout_seconds: 20

# Optional provider endpoint and request headers are resolved locally.
# OPENAI_API_BASE=https://your-provider.example/v1
# extra_headers:
#   Provider-Header: value
